# Frontend runtime mode: mock | api
VITE_APP_MODE=api

# Optional API base URL. Keep empty for same-origin calls.
VITE_API_BASE_URL=

# Backend data mode: mock | sheets
APP_DATA_MODE=sheets

# Google OAuth (identity-only)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/callback

# Session signing
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=aolf_session

# Google Sheets Service Account access
GOOGLE_SHEETS_DATA_SPREADSHEET_ID=your_data_spreadsheet_id
# Optional; leave empty to reuse GOOGLE_SHEETS_DATA_SPREADSHEET_ID
GOOGLE_SHEETS_ACCESS_SPREADSHEET_ID=

# Optional sheet layout override
GOOGLE_SHEETS_LAYOUT_JSON={"leadsRange":"Leads!A:Z","membersRange":"Members!A:Z","coursesRange":"Activities!A:Z","courseTemplatesRange":"CourseTemplates!A:B","configRange":"Config!A:B","allowedUsersRange":"AllowedUsers!A:Z"}

# From service account JSON (client_email)
GOOGLE_SERVICE_ACCOUNT_EMAIL=aolf-club@aolfclub.iam.gserviceaccount.com

# From service account JSON (private_key)
# Keep newline escapes as \n when using single-line env values.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----\n

# Vercel Blob (activity images). Create a Public Blob store in the Vercel project.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_REPLACE_WITH_TOKEN

# WhatsApp Business Cloud API (Phase I)
META_VERIFY_TOKEN=replace-with-meta-verify-token
META_ACCESS_TOKEN=replace-with-meta-access-token
META_PHONE_NUMBER_ID=replace-with-meta-phone-number-id
META_APP_SECRET=replace-with-meta-app-secret

# Optional
META_API_VERSION=v21.0
WHATSAPP_PENDING_TTL_SECONDS=300
